{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAKEFLAGS": "-j4",
    "CMAKE_BUILD_PARALLEL_LEVEL": "4",
    "CTEST_PARALLEL_LEVEL": "4",
    "CARGO_BUILD_JOBS": "4",
    "RAYON_NUM_THREADS": "4",
    "GOMAXPROCS": "4",
    "OMP_NUM_THREADS": "4",
    "NPM_CONFIG_JOBS": "4",
    "PYTEST_XDIST_AUTO_NUM_WORKERS": "4"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/start-docker.sh",
            "async": true,
            "timeout": 60,
            "statusMessage": "Starting Docker daemon"
          }
        ]
      }
    ]
  }
}
